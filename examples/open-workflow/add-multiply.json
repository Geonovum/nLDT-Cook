{
  "document": {
    "dsl": "1.0.3",
    "namespace": "https://nldt.geonovum.nl/cook",
    "name": "add-multiply",
    "version": "1.0.0",
    "title": "Add, then multiply",
    "summary": "step2a and step2b both read step1.sum and run together. step3 reads step2b.product. step2b is asynchronous."
  },
  "do": [
    {
      "step1": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://127.0.0.1:8080/geonovum/v1/processes/add/execution",
          "headers": { "Content-Type": "application/json" },
          "body": {
            "inputs": { "number1": 10, "number2": 7 }
          }
        },
        "export": { "as": "${ $context + { step1: . } }" }
      }
    },
    {
      "step2a": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://127.0.0.1:8080/geonovum/v1/processes/multiply/execution",
          "headers": { "Content-Type": "application/json" },
          "body": {
            "inputs": {
              "number1": "${ $context.step1.sum }",
              "number2": 5
            }
          }
        },
        "export": { "as": "${ $context + { step2a: . } }" }
      }
    },
    {
      "step2b": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://127.0.0.1:8080/geonovum/v1/processes/multiply/execution",
          "headers": {
            "Content-Type": "application/json",
            "Prefer": "respond-async"
          },
          "body": {
            "inputs": {
              "number1": "${ $context.step1.sum }",
              "number2": 6
            },
            "subscriber": {
              "successUri": "http://127.0.0.1:8081/oven/v1/callback/:jobId?type=success",
              "inProgressUri": "http://127.0.0.1:8081/oven/v1/callback/:jobId?type=inProgress",
              "failedUri": "http://127.0.0.1:8081/oven/v1/callback/:jobId?type=failed"
            }
          }
        },
        "export": { "as": "${ $context + { step2b: . } }" }
      }
    },
    {
      "step3": {
        "call": "http",
        "with": {
          "method": "post",
          "endpoint": "http://127.0.0.1:8080/geonovum/v1/processes/multiply/execution",
          "headers": { "Content-Type": "application/json" },
          "body": {
            "inputs": {
              "number1": "${ $context.step2b.product }",
              "number2": "${ $workflow.input.mobilityData }"
            }
          }
        }
      }
    }
  ],
  "output": {
    "as": "${ { step2a: $context.step2a, step3: . } }"
  }
}
